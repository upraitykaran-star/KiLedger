KILEDGER_ENV=development
KILEDGER_MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
KILEDGER_DATABASE=kileger
KILEDGER_SESSION_COOKIE=kileger_session
KILEDGER_SESSION_DAYS=7
KILEDGER_COOKIE_SECURE=false
KILEDGER_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
KILEDGER_ALLOWED_HOSTS=localhost,127.0.0.1
KILEDGER_RATE_LIMIT=10
KILEDGER_RATE_WINDOW_SECONDS=60
